# --- Secrets: never commit these ---
.env
.env.local
.env.*.local
*.pem
service-account*.json
gee-credentials*.json

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Data ---
# Raw downloads are large and reproducible from scripts/ — keep them out of git.
backend/data/raw/*
!backend/data/raw/.gitkeep
!backend/data/raw/README.md
# Read by the running app, though it lives with the raw inputs.
!backend/data/raw/population_cells.json
# Build outputs, except the ones the running app reads: about 15 MB, against
# scripts that take minutes and depend on often-overloaded map servers. Allowed
# by name so backups and caches stay out. See backend/data/README.md.
backend/data/processed/*
!backend/data/processed/.gitkeep
!backend/data/processed/grid.json
!backend/data/processed/map_pois.json
!backend/data/processed/roads_major.json
!backend/data/processed/cameras.json
!backend/data/processed/signals.json
!backend/data/processed/ntls.json
!backend/data/processed/cds.json
# The news archive is NOT a build output — it accumulates one day at a time and
# cannot be regenerated once lost, because the source articles rotate off the
# feeds. Kept out of git because it grows without bound and carries article
# URLs, but it is the one thing here that needs a real backup.
backend/data/archive/*
!backend/data/archive/.gitkeep
!backend/data/archive/README.md
*.tif
*.tiff
*.h5
*.nc
*.parquet
*.sqlite
*.db

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini
