# Copy to `.env` (gitignored). Vite only exposes vars prefixed with VITE_.

# Where the backend is running.
VITE_API_BASE=http://localhost:8000

# Leave blank to use free OpenStreetMap tiles via Leaflet — no key needed, and
# the default for local development. Only set this if you switch MapView over
# to the Google Maps JS SDK.
VITE_GOOGLE_MAPS_API_KEY=
