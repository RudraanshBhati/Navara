# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it, and never paste a key into a PR.

# ---------------------------------------------------------------------------
# REQUIRED for route fetching (milestone 4 onward)
# ---------------------------------------------------------------------------
# Google Maps Platform key with the Routes API AND Geocoding API enabled.
# Billing must be active on the project. Restrict the key to those two APIs.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# REQUIRED for the news agent (NSI layer)
# ---------------------------------------------------------------------------
# Used by LangChain/LangGraph to extract structured incidents from articles.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# NASA Earthdata bearer token, for downloading VIIRS VNP46A2 night-lights
# rasters used by the NTLS layer. Free, instant signup:
# https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=

# Extra news source. The agent works without it — GDELT and RSS need no key.
# https://newsapi.org/
NEWSAPI_KEY=

# ---------------------------------------------------------------------------
# Tuning (defaults in app/config.py are fine to start)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
NEWS_MODEL=claude-sonnet-5
