# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it, and never paste a key into a PR.

# ---------------------------------------------------------------------------
# REQUIRED for route fetching (milestone 4 onward)
# ---------------------------------------------------------------------------
# Google Maps Platform key with the Routes API AND Geocoding API enabled.
# Billing must be active on the project. Restrict the key to those two APIs.
# https://console.cloud.google.com/google/maps-apis/credentials
GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Incident extraction for the news agent (NSI layer)
# ---------------------------------------------------------------------------
# "anthropic" (needs the key below) or "ollama" (local, no key, no billing).
#
# Ollama exists here because the archive CIP and TRC depend on accumulates in
# calendar time — a month not spent running the agent is a month of crime data
# that cannot be recovered, because the articles rotate off the feeds. Running
# locally tonight beats running properly next month.
EXTRACTION_PROVIDER=anthropic

# Used by LangChain/LangGraph to extract structured incidents from articles.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local extraction. Install Ollama (https://ollama.com), then:
#   ollama pull gemma3:12b
# Model choice matters more than it looks — several local models ignore the
# output schema, answer in prose, and produce runs reporting zero incidents that
# look exactly like a quiet news day. Compare before switching:
#   python scripts/eval_extractor.py --models gemma3:12b,phi4:14b
OLLAMA_MODEL=gemma3:12b
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# NASA Earthdata bearer token, for downloading VIIRS VNP46A2 night-lights
# rasters used by the NTLS layer. Free, instant signup:
# https://urs.earthdata.nasa.gov/
EARTHDATA_TOKEN=

# Extra news source. The agent works without it — GDELT and RSS need no key.
# https://newsapi.org/
NEWSAPI_KEY=

# ---------------------------------------------------------------------------
# Tuning (defaults in app/config.py are fine to start)
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
NEWS_MODEL=claude-sonnet-5
